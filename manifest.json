{
  "manifest_version": 3,
  "name": "www_AD_Blocker",
  "version": "3.4",
  "description": "PC 크롬에서 웹사이트 광고와 추적기를 차단하고 통계를 확인합니다.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.googlesyndication.com/*",
    "*://*.doubleclick.net/*",
    "*://*.adsense.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.google-analytics.com/*",
    "*://*.googletagmanager.com/*",
    "https://easylist.to/",
    "https://filters.adtidy.org/",
    "https://raw.githubusercontent.com/",
    "https://adblock.turtlecute.org/",
    "https://www.fanboy.co.nz/",
    "https://gitlab.com/",
    "https://pgl.yoyo.org/",
    "https://cdn.jsdelivr.net/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "filters/static-index.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist_1",
        "enabled": false,
        "path": "filters/ruleset_easylist.json"
      },
      {
        "id": "easylist_2",
        "enabled": false,
        "path": "filters/ruleset_easylist_2.json"
      },
      {
        "id": "easylist_3",
        "enabled": false,
        "path": "filters/ruleset_easylist_3.json"
      },
      {
        "id": "easylist_4",
        "enabled": false,
        "path": "filters/ruleset_easylist_4.json"
      },
      {
        "id": "adguard_1",
        "enabled": false,
        "path": "filters/ruleset_adguard.json"
      },
      {
        "id": "adguard_2",
        "enabled": false,
        "path": "filters/ruleset_adguard_2.json"
      },
      {
        "id": "adguard_3",
        "enabled": false,
        "path": "filters/ruleset_adguard_3.json"
      },
      {
        "id": "peterlowe_1",
        "enabled": false,
        "path": "filters/ruleset_peterlowe.json"
      },
      {
        "id": "uassets_1",
        "enabled": false,
        "path": "filters/ruleset_uassets.json"
      },
      {
        "id": "korean_1",
        "enabled": false,
        "path": "filters/ruleset_korean.json"
      },
      {
        "id": "social_1",
        "enabled": false,
        "path": "filters/ruleset_social.json"
      },
      {
        "id": "anti_cv_1",
        "enabled": false,
        "path": "filters/ruleset_anti_cv.json"
      },
      {
        "id": "annoyances_1",
        "enabled": false,
        "path": "filters/ruleset_annoyances.json"
      },
      {
        "id": "malware_1",
        "enabled": false,
        "path": "filters/ruleset_malware.json"
      },
      {
        "id": "malware_2",
        "enabled": false,
        "path": "filters/ruleset_malware_2.json"
      },
      {
        "id": "malware_3",
        "enabled": false,
        "path": "filters/ruleset_malware_3.json"
      },
      {
        "id": "malware_4",
        "enabled": false,
        "path": "filters/ruleset_malware_4.json"
      },
      {
        "id": "malware_5",
        "enabled": false,
        "path": "filters/ruleset_malware_5.json"
      },
      {
        "id": "mining_1",
        "enabled": false,
        "path": "filters/ruleset_mining.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "anti-bypass.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "general-blocker.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "js": [
        "chzzk-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "js": [
        "chzzk-ad-skip.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.gigafile.nu/*",
        "*://*.gofile.io/*",
        "*://*.gofile.to/*",
        "*://*.akirabox.com/*",
        "*://*.akirabox.to/*",
        "*://*.buzzheavier.com/*",
        "*://*.bzzhr.to/*"
      ],
      "js": [
        "filehost-blocker.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.skidrowreloaded.com/*"
      ],
      "js": [
        "popunder-blocker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "element-blocker.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "www_AD_Blocker",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
