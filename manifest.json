{
  "manifest_version": 3,
  "name": "www_AD_Blocker",
  "version": "3.2",
  "description": "PC 크롬에서 유튜브 광고를 차단하고 통계를 확인합니다.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.googlesyndication.com/*",
    "*://*.doubleclick.net/*",
    "*://*.adsense.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.google-analytics.com/*",
    "*://*.googletagmanager.com/*",
    "https://easylist.to/",
    "https://filters.adtidy.org/",
    "https://raw.githubusercontent.com/",
    "https://adblock.turtlecute.org/",
    "https://www.fanboy.co.nz/",
    "https://gitlab.com/",
    "https://cdn.jsdelivr.net/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads_1", "enabled": true, "path": "filters/ruleset_ads.json" },
      { "id": "ads_2", "enabled": true, "path": "filters/ruleset_ads_2.json" },
      { "id": "ads_3", "enabled": true, "path": "filters/ruleset_ads_3.json" },
      { "id": "ads_4", "enabled": true, "path": "filters/ruleset_ads_4.json" },
      { "id": "ads_5", "enabled": true, "path": "filters/ruleset_ads_5.json" },
      { "id": "korean", "enabled": true, "path": "filters/ruleset_korean.json" },
      { "id": "privacy", "enabled": true, "path": "filters/ruleset_privacy.json" },
      { "id": "anti_circumvention", "enabled": true, "path": "filters/ruleset_anti_circumvention.json" },
      { "id": "annoyances", "enabled": true, "path": "filters/ruleset_annoyances.json" },
      { "id": "security_1", "enabled": true, "path": "filters/ruleset_security.json" },
      { "id": "security_2", "enabled": true, "path": "filters/ruleset_security_2.json" },
      { "id": "security_3", "enabled": true, "path": "filters/ruleset_security_3.json" },
      { "id": "security_4", "enabled": true, "path": "filters/ruleset_security_4.json" },
      { "id": "security_5", "enabled": true, "path": "filters/ruleset_security_5.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["anti-bypass.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["general-blocker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.gigafile.nu/*",
        "*://*.gofile.io/*",
        "*://*.gofile.to/*",
        "*://*.akirabox.com/*",
        "*://*.akirabox.to/*",
        "*://*.buzzheavier.com/*",
        "*://*.bzzhr.to/*"
      ],
      "js": ["filehost-blocker.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.skidrowreloaded.com/*"],
      "js": ["popunder-blocker.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["element-blocker.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "www_AD_Blocker",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}